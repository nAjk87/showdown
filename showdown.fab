    PLAYER_RUN_2_NO_KATANA_HEAD_TILE, PLAYER_RUN_2_NO_KATANA_LEGS_TILE,
    PLAYER_WALL_SLIDE_NO_KATANA_HEAD_TILE, PLAYER_WALL_SLIDE_NO_KATANA_LEGS_TILE,
